        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.SOFYAN_OS_API_KEY}}"
            }
          ]
        }
      },
      "id": "2",
      "name": "Get Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{'https://api.telegram.org/bot' + $env.TELEGRAM_BOT_TOKEN + '/sendMessage'}}",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({chat_id:$env.TELEGRAM_CHAT_ID,text:'Sofyan OS pagi\\nHighlight: '+$json.highlights+'/3\\nInbox: '+$json.inbox+'\\nTask: '+$json.open_tasks+'\\nProject: '+$json.active_projects+'\\nCashflow: Rp'+Number($json.cashflow).toLocaleString('id-ID')+'\\nUtang: Rp'+Number($json.debt_balance).toLocaleString('id-ID')}) }}"
      },
      "id": "3",
      "name": "Send Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        0
      ]
    }
  ],
  "pinData": {},
  "connections": {
