{
  "name": "Sofyan OS - Daily Review",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 20,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "1",
      "name": "20:00 Daily",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{$env.SOFYAN_OS_URL + '/api/daily-review'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.SOFYAN_OS_API_KEY}}"
            }
          ]
        }
      },
      "id": "2",
      "name": "Get Daily Review",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{'https://api.telegram.org/bot' + $env.TELEGRAM_BOT_TOKEN + '/sendMessage'}}",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({chat_id:$env.TELEGRAM_CHAT_ID,text:'Review malam\\nInbox: '+$json.inbox.length+'\\nCandidate highlight: '+$json.candidate_highlights.slice(0,5).map(x=>'\u2022 '+x.title).join('\\n')+'\\nDependencies: '+$json.dependencies.length}) }}"
      },
      "id": "3",
      "name": "Send Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        0
      ]
    }
  ],
  "pinData": {},
  "connections": {
    "20:00 Daily": {
      "main": [
        [
          {
            "node": "Get Daily Review",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Daily Review": {
      "main": [
        [
          {
            "node": "Send Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "00000000-0000-0000-0000-000000000001",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}