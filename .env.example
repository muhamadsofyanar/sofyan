APP_NAME=Sofyan OS
APP_DOMAIN=app.ruanglegalitas.com

# Ganti sebelum production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-ini
SESSION_SECRET=ganti-dengan-random-string-panjang

POSTGRES_DB=sofyan_os
POSTGRES_USER=sofyan
POSTGRES_PASSWORD=ganti-password-db
DATABASE_URL=postgresql+psycopg://sofyan:ganti-password-db@db:5432/sofyan_os

# Opsional, untuk integrasi n8n/API
API_KEY=ganti-api-key-random

TZ=Asia/Jakarta

# Telegram capture
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=sofyan-os-telegram-secret
TELEGRAM_WEBHOOK_URL=https://app.ruanglegalitas.com/api/telegram/webhook

# AI classification (optional but supported)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Daily review / automation endpoints
DAILY_REVIEW_HOUR=20
